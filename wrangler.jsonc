{
  // ============================================================
  //  Multi-worker config (one repo -> three Workers).
  //
  //  Each Worker serves a different folder as its static assets:
  //
  //    wrangler deploy --env public   ->  Worker "public"  serves ./public
  //    wrangler deploy --env bonus    ->  Worker "bonus"   serves ./bonus
  //    wrangler deploy --env halo     ->  Worker "halo"    serves ./halo
  //
  //  Shortcuts (see package.json):
  //    npm run deploy:public | deploy:bonus | deploy:halo
  //    npm run deploy:all      (deploys all three in sequence)
  //
  //  The top-level settings below are the defaults for the "public" worker;
  //  the "env" blocks override name + assets folder for the others.
  //
  //  Custom domains are NOT set here. Attach a domain to each Worker in the
  //  Cloudflare dashboard: Workers & Pages -> (worker) -> Settings ->
  //  Domains & Routes -> Add -> Custom Domain. See DEPLOY.md.
  // ============================================================

  "name": "public",
  "compatibility_date": "2026-06-07",
  "main": "./src/index.js",

  "assets": {
    "directory": "./public",
    // Lets the Worker hand non-API requests back to the asset pipeline.
    "binding": "ASSETS"
  },

  // Optional install-counter storage (disabled by default). To enable it for a
  // given worker, create a namespace and add a matching kv_namespaces block
  // (either top-level or inside that env):
  //   1. npx wrangler kv namespace create INSTALL_COUNTER
  //   2. "kv_namespaces": [
  //        { "binding": "INSTALL_COUNTER", "id": "PASTE_REAL_NAMESPACE_ID_HERE" }
  //      ]

  "env": {
    // Worker "public"  ->  ./public
    "public": {
      "name": "public",
      "main": "./src/index.js",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS"
      }
    },

    // Worker "bonus"   ->  ./bonus   (e.g. the BONUS138 PWA at /pwa/)
    "bonus": {
      "name": "bonus",
      "main": "./src/index.js",
      "assets": {
        "directory": "./bonus",
        "binding": "ASSETS"
      }
    },

    // Worker "halo"    ->  ./halo
    "halo": {
      "name": "halo",
      "main": "./src/index.js",
      "assets": {
        "directory": "./halo",
        "binding": "ASSETS"
      }
    }
  }
}
